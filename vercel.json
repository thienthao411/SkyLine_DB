{
  "framework": null,
  "installCommand": "cd SKYLINE-main && npm install",
  "buildCommand": "cd SKYLINE-main && npm run build",
  "outputDirectory": "SKYLINE-main/dist/skyline/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
